# Environment variables for DocuRAG
# Copy this to .env and fill in your values.

# ── LLM API (NVIDIA NIM / OpenAI compatible) ────────────────────────
OPENAI_API_KEY=nvapi-your-nvidia-key-here
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=deepseek-ai/deepseek-v4.1-flash

# ── Langfuse Observability (self-hosted) ─────────────────────────────
# After running `docker compose up`, create a project in the Langfuse UI
# at http://localhost:3000, then copy the API keys here.
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here

# ── Optional overrides (defaults are in src/config.py) ───────────────
# CHROMA_PATH=./chroma_db
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50
# MAX_PAGES_PER_SOURCE=40
